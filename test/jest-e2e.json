{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "preset": "ts-jest",
  "setupFilesAfterEnv": [
    "./setup.ts"
  ],
  "transformIgnorePatterns": [
    "/node_modules/(?!@faker-js/faker)"
  ]
}